<resources>
    <style name="Theme.EndraLink" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorPrimaryVariant">@color/blue</item>
        <item name="colorOnPrimary">@color/navy</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorOnSecondary">@color/navy</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/silver</item>
        <item name="android:colorBackground">@color/navy</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:textColorPrimary">@color/silver</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/cyan</item>
    </style>
    <style name="EndraButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/button_fill</item>
        <item name="android:textColor">@color/button_text</item>
    </style>
    <style name="EndraOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/outline_text</item>
    </style>
    <style name="TechButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/tech_button</item><item name="backgroundTint">@null</item><item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/tech_text</item><item name="android:textAllCaps">false</item><item name="android:textSize">18sp</item><item name="android:textStyle">bold</item>
        <item name="android:minHeight">60dp</item><item name="android:padding">12dp</item><item name="android:layout_marginTop">8dp</item><item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="TechButtonPrimary" parent="TechButton"><item name="android:background">@drawable/tech_primary</item><item name="android:textColor">@color/button_text</item></style>
</resources>
