<selector xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:state_enabled="false"><shape><solid android:color="#15202B"/><stroke android:width="1dp" android:color="#4A5968"/><corners android:radius="18dp"/></shape></item>
 <item android:state_pressed="true"><shape><solid android:color="#237C9B"/><stroke android:width="3dp" android:color="#A8F6FF"/><corners android:radius="18dp"/></shape></item>
 <item android:state_focused="true"><shape><solid android:color="#237C9B"/><stroke android:width="3dp" android:color="#A8F6FF"/><corners android:radius="18dp"/></shape></item>
 <item><shape><gradient android:startColor="#12364E" android:endColor="#04111F" android:angle="270"/><stroke android:width="2dp" android:color="#19D5F5"/><corners android:radius="18dp"/></shape></item>
</selector>