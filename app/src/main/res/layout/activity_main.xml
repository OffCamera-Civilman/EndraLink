<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/navy">
    <ScrollView android:id="@+id/homePage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
            <com.endralink.app.ArtworkView android:id="@+id/homeArtwork" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:baselineAligned="false">
                <Button android:id="@+id/homeFx" style="@style/TechButtonPrimary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="100dp" android:text="fx-CG50" android:contentDescription="Open fx-CG50 workspace"/>
                <Button android:id="@+id/homeNspire" style="@style/TechButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="100dp" android:layout_marginStart="8dp" android:text="TI-Nspire\nComing later" android:textSize="13sp" android:enabled="false"/>
                <Button android:id="@+id/homePrime" style="@style/TechButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="100dp" android:layout_marginStart="8dp" android:text="HP Prime\nComing later" android:textSize="13sp" android:enabled="false"/>
            </LinearLayout>
            <Button android:id="@+id/homeDonate" style="@style/TechButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:text="♡ Donate — coming later" android:enabled="false"/>
            <TextView android:id="@+id/homeVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:gravity="center" android:text="EndraLink" android:textColor="@color/muted" android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>
<ScrollView
    android:id="@+id/workspacePage" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/navy" android:visibility="gone" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp" android:gravity="center_horizontal">
        <Button android:id="@+id/homeBack" style="@style/TechButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹ Home"/>
        <com.endralink.app.ArtworkView android:id="@+id/workspaceHeader" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="FILE TRANSFER" android:textSize="12sp" android:letterSpacing="0.08" android:textColor="@color/cyan"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:background="@drawable/panel" android:padding="20dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="USB CONNECTION"
                android:textSize="11sp" android:letterSpacing="0.12" android:textColor="@color/muted"/>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Connect your fx-CG50" android:textSize="20sp"
                android:textStyle="bold" android:textColor="@color/silver" android:accessibilityLiveRegion="polite"/>
            <TextView android:id="@+id/deviceDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Use USB Flash mode on the calculator." android:textColor="@color/muted" android:textSize="13sp"/>
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="16dp"
                android:indeterminateTint="@color/cyan" android:visibility="gone"/>
        </LinearLayout>
        <Button android:id="@+id/connect" style="@style/TechButtonPrimary"
            android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Connect fx-CG50"/>
        <Button android:id="@+id/browse" style="@style/TechButton"
            android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content" android:text="Browse calculator" android:enabled="false"/>
        <LinearLayout android:id="@+id/browserPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/panel" android:padding="16dp" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/storageInfo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textColor="@color/cyan" android:textSize="12sp"/>
                <Button android:id="@+id/collapseBrowser" style="@style/TechButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Collapse"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/browserBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/folderPath" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="/" android:textSize="18sp" android:textColor="@color/silver"/>
                <Button android:id="@+id/upFolder" style="@style/TechButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Parent folder"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/newCalcFile" style="@style/TechButton"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="New file"/>
                    <Button android:id="@+id/newCalcFolder" style="@style/TechButton"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="New folder"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/fileList" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/transferPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:background="@drawable/panel" android:padding="16dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="ENDRALINK PHONE FILE MANAGER" android:textSize="11sp" android:letterSpacing="0.12" android:textColor="@color/muted"/>
                <Button android:id="@+id/collapsePhoneStorage" style="@style/TechButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Collapse"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/phoneStorageBody" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/openPhone" style="@style/TechButton"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Choose phone folder"/>
                    <Button android:id="@+id/phoneUp" style="@style/TechButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:text="Up" android:enabled="false"/>
                    <Button android:id="@+id/clearQueue" style="@style/TechButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:text="Clear" android:enabled="false"/>
                </LinearLayout>
                <TextView android:id="@+id/phonePath" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Grant a phone folder once, then browse it here." android:textColor="@color/cyan" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                <LinearLayout android:id="@+id/phoneFileBrowser" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
            <TextView android:id="@+id/progressText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="No files or folders selected" android:textColor="@color/muted" android:paddingTop="8dp" android:paddingBottom="8dp"/>
            <LinearLayout android:id="@+id/localFileList" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>
            <ProgressBar android:id="@+id/transferProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:indeterminate="true"
                android:indeterminateTint="@color/cyan" android:visibility="gone"/>
            <Button android:id="@+id/copy" style="@style/TechButtonPrimary"
                android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content"
                android:text="Transfer selected items" android:enabled="false"/>
        </LinearLayout>
        <Button android:id="@+id/eject" style="@style/TechButton"
            android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content" android:text="Eject calculator" android:enabled="false"/>
        <Button android:id="@+id/exportLog" style="@style/TechButton"
            android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_height="wrap_content" android:text="Export debug log"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Two-way EndraLink file manager enabled. Existing files require confirmation before overwrite."
            android:textSize="12sp" android:gravity="center" android:textColor="@color/muted" android:paddingBottom="16dp"/>
        <com.endralink.app.ArtworkView android:id="@+id/workspaceFooter" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>

</FrameLayout>
