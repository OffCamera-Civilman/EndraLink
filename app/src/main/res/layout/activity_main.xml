<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="EndraLink" android:textSize="30sp" android:textStyle="bold" android:gravity="center"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Connect an fx-CG50 by USB" android:gravity="center" android:padding="12dp"/>
    <Button android:id="@+id/openPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open phone file"/>
    <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connect calculator"/>
    <Button android:id="@+id/copy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Copy to calculator"/>
    <Button android:id="@+id/eject" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Eject / disconnect"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="fx-CG50 storage: FAT16-compatible file operations" android:gravity="center" android:padding="16dp"/>
</LinearLayout>
